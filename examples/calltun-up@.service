# /etc/systemd/system/calltun-up@.service — initiator side of link %i.
# Spawns `ssh $SSH_ALIAS calltun offer --link %i` per attempt; the ssh
# session (and any tor circuit under it) dies after ICE connects and the
# link lives on its own.
[Unit]
Description=calltun initiator for link %i
After=networking.service network-online.target
Wants=network-online.target
After=sys-subsystem-net-devices-%i.device
Wants=sys-subsystem-net-devices-%i.device
BindsTo=sys-subsystem-net-devices-%i.device
PartOf=networking.service

[Service]
User=calltun
Group=calltun
EnvironmentFile=/etc/calltun/%i.env
# SSH_ALIAS=peer-host          (ssh_config alias; tor via ProxyCommand there)
# STUN=stun.l.google.com:19302 (or "none" for host candidates only)
# CALLTUN_NO_IF=               (extra interfaces to never gather ICE
#                               candidates on, comma list; --no-if wins)
# CALLTUN_IF=eth0              (pin gathering to these interfaces ONLY —
#                               wins over NO_IF; for multi-link hosts)
ExecStart=/usr/local/bin/calltun up --link %i --dev %i --mode tun --ssh ${SSH_ALIAS}
ExecStartPost=/bin/sh -c 'i=0; until [ "$(cat /sys/class/net/%i/carrier 2>/dev/null)" = 1 ]; do i=$((i+1)); [ $i -ge 30 ] && exit 1; sleep 1; done'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
